@@ -213,6 +215,44 @@ func ContextFrom(ctx context.Context) *InboundContext {
 	return metadata.(*InboundContext)
 }
 
+func (c *InboundContext) EnableActiveOutboundTracking() {
+	if c.ActiveOutboundTracker == nil {
+		c.ActiveOutboundTracker = new(atomic.Pointer[string])
+	}
+}
+
+func (c InboundContext) ActiveOutbound() string {
+	if c.ActiveOutboundTracker == nil {
+		return ""
+	}
+	activeOutbound := c.ActiveOutboundTracker.Load()
+	if activeOutbound == nil {
+		return ""
+	}
+	return *activeOutbound
+}
+
+type activeOutboundTrackerContextKey struct{}
+
+func ContextWithActiveOutboundTracker(ctx context.Context, metadata InboundContext) context.Context {
+	if metadata.ActiveOutboundTracker == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, (*activeOutboundTrackerContextKey)(nil), metadata.ActiveOutboundTracker)
+}
+
+func RecordActiveOutbound(ctx context.Context, tag string) {
+	if tag == "" {
+		return
+	}
+	tracker, loaded := ctx.Value((*activeOutboundTrackerContextKey)(nil)).(*atomic.Pointer[string])
+	if !loaded || tracker == nil {
+		return
+	}
+	activeOutbound := tag
+	tracker.Store(&activeOutbound)
+}
+
