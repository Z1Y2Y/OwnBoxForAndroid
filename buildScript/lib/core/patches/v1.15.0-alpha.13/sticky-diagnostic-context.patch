+type stickyDiagnosticDetourPathKey struct{}
+
+func StickyDiagnosticDetourPathFromContext(ctx context.Context) []string {
+	if ctx == nil {
+		return nil
+	}
+	path, _ := ctx.Value(stickyDiagnosticDetourPathKey{}).([]string)
+	return append([]string(nil), path...)
+}
+
+func ContextWithStickyDiagnosticDetour(ctx context.Context, outboundTag string) context.Context {
+	if !stickyDiagnosticBuildEnabled || ctx == nil || outboundTag == "" {
+		return ctx
+	}
+	path := StickyDiagnosticDetourPathFromContext(ctx)
+	if len(path) >= 8 {
+		return ctx
+	}
+	path = append(path, outboundTag)
+	return context.WithValue(ctx, stickyDiagnosticDetourPathKey{}, path)
+}
